# Local (sem serviços externos): PGlite persistido em ./.pglite
# DATABASE_URL=file:./.pglite
# Produção: URL do Neon
# DATABASE_URL=postgresql://<usuario>:<senha>@<host>.neon.tech/<banco>?sslmode=require
DATABASE_URL=
IP_HASH_SALT=
# Formulários de sugestão e de problema: token fine-grained só deste repositório, Issues: read and write.
# Sem ele, o envio responde 503 e o formulário oferece abrir a issue direto no GitHub.
GITHUB_ISSUES_TOKEN=
